# Salin menjadi .env:  cp .env.example .env   lalu GANTI kedua password.
# .env sudah di-.gitignore; jangan pernah di-commit.
MYSQL_ROOT_PASSWORD=GANTI_PASSWORD_ROOT
MYSQL_DATABASE=toko
MYSQL_USER=admin
MYSQL_PASSWORD=GANTI_PASSWORD_APLIKASI

# Port di komputermu (opsional)
API_PORT=8080
ADMINER_PORT=8081
